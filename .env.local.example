# Supabase Configuration
# Obtén estos valores en https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave de Administración para el Panel (/admin)
ADMIN_PASSWORD=canon

# Spotify API Configuration (Opcional pero recomendado para importar playlists completas)
# Crea tu aplicación en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
